{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "NODE_EXTRA_CA_CERTS", "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "PGLITE_DIR", "NEXT_PUBLIC_SITE_URL", "ADMIN_TOKEN", "REPORT_HASH_SECRET"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "env": ["DATABASE_URL", "PGLITE_DIR", "REPORT_HASH_SECRET"] }
  }
}
