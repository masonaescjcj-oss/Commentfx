{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NODE_EXTRA_CA_CERTS",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ADMIN_TOKEN",
        "BING_SITE_VERIFICATION",
        "DATABASE_URL",
        "DB_POOL_MAX",
        "GOOGLE_SITE_VERIFICATION",
        "MIGRATE_DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "PGLITE_DIR",
        "REPORT_HASH_SECRET",
        "SESSION_SECRET"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "env": [
        "DATABASE_URL",
        "DB_POOL_MAX",
        "MIGRATE_DATABASE_URL",
        "PGLITE_DIR",
        "REPORT_HASH_SECRET",
        "SESSION_SECRET"
      ]
    }
  }
}
