# Everything this site needs to run, and nothing it does not. There is no API
# key here because there is no paid source behind any page: every upstream is a
# free, unauthenticated endpoint, and each one fails to an honest "we could not
# read this" rather than to a broken page.

# ── Site ──────────────────────────────────────────────────────────────
# The site's own origin. Canonical URLs, the sitemap, robots.txt and every
# piece of structured data are built from it, so a preview deploy left on the
# default is telling Google that production is the canonical version of itself.
NEXT_PUBLIC_SITE_URL=https://commentfx.com

# ── Database ──────────────────────────────────────────────────────────
# Unset, the site is read-only: every page renders from the curated data and
# nothing can be written. Reviews, status reports, verifications, editor
# overrides and accounts all need this.
DATABASE_URL=postgres://commentfx:commentfx@localhost:5432/commentfx

# Only on a deployment whose DATABASE_URL is a *pooler* — Supabase's pooler,
# pgbouncer, anything in transaction mode. Migrations take a session-held
# advisory lock, and a lock taken on one backend and released on another has
# not locked anything. Point this at the direct connection (Supabase: session
# mode, port 5432) and leave DATABASE_URL on the pooler.
# MIGRATE_DATABASE_URL=

# Connections per instance. The default of 3 suits a serverless host, where
# there may be dozens of instances at once; raise it behind a real server.
# DB_POOL_MAX=3

# ── The admin ─────────────────────────────────────────────────────────
# With neither of these set, every /admin route 404s and the surface is
# invisible. See docs/DEPLOY.md.

# Signs the session cookie, and the switch that turns accounts on.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Break-glass. Set it long enough to open /admin/setup and create the first
# account, then unset it — it has no name and no role, so it reaches every
# screen and writes nothing.
ADMIN_TOKEN=

# ── Reader reports ────────────────────────────────────────────────────
# Salts the hash that rate-limits status reports. Unset, the salt is per
# process: the limit resets on every restart and differs between instances.
REPORT_HASH_SECRET=

# ── Search Console, optional ──────────────────────────────────────────
# The verification strings, if you verify by meta tag rather than by DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
