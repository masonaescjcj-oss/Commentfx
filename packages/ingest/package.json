{
  "name": "@commentfx/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "probe": "node --experimental-strip-types src/probe.ts",
    "registers:report": "node --experimental-strip-types src/registers/report.ts",
    "sites:report": "node --experimental-strip-types src/sites-report.ts"
  },
  "dependencies": {
    "@commentfx/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0"
  }
}
